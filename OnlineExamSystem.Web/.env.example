# ASP.NET Core Web API:
# - Local (chạy qua Vite proxy trong vite.config.ts): để trống hoặc không cần đặt.
# - Production (Vercel): đặt URL đầy đủ của Backend (ví dụ: https://your-backend-domain.com)
VITE_API_BASE_URL=

# Tùy chọn: dùng cho Gia sư AI và sinh học liệu.
GEMINI_API_KEY=your_gemini_api_key_here
